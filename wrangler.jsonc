{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawl-buddy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APIFY_FACEBOOK_ACTOR": "clappi/facebook-posts-reels-scraper",
    "APIFY_TIMEOUT_SECS": "55"
  }
}
